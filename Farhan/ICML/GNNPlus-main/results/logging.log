        (ff_linear2): Linear(in_features=256, out_features=128, bias=True)
        (act_fn_ff): ReLU()
        (norm2): BatchNorm1d(128, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)
        (ff_dropout1): Dropout(p=0.2, inplace=False)
        (ff_dropout2): Dropout(p=0.2, inplace=False)
      )
      (2): GCNConvLayer(
        (bn_node_x): BatchNorm1d(128, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)
        (act): Sequential(
          (0): ReLU()
          (1): Dropout(p=0.2, inplace=False)
        )
        (model): GCNConv(128, 128)
        (norm1_local): BatchNorm1d(128, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)
        (ff_linear1): Linear(in_features=128, out_features=256, bias=True)
        (ff_linear2): Linear(in_features=256, out_features=128, bias=True)
        (act_fn_ff): ReLU()
        (norm2): BatchNorm1d(128, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)
        (ff_dropout1): Dropout(p=0.2, inplace=False)
        (ff_dropout2): Dropout(p=0.2, inplace=False)
      )
    )
    (post_mp): MLPGraphHead(
      (mlp): Sequential(
        (0): Dropout(p=0.2, inplace=False)
        (1): Linear(in_features=128, out_features=128, bias=True)
        (2): ReLU()
        (3): Dropout(p=0.2, inplace=False)
        (4): Linear(in_features=128, out_features=21, bias=True)
      )
    )
  )
)
