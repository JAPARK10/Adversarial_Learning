          (0): BatchNorm1d(128, eps=1e-05, momentum=0.1, affine=True, track_running_stats=True)
          (1): Dropout(p=0.3, inplace=False)
          (2): ReLU()
        )
      )
    )
    (gnn_layers): Sequential(
      (0): GINEConvLayer(
